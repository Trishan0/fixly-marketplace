# Local Vite uses /api through its dev proxy. On Vercel, set the full backend URL,
# for example: https://fixly-api.vercel.app/api
VITE_API_URL=/api

# Use "local" for normal local development and "blob" in Vercel Preview/Production.
VITE_STORAGE_DRIVER=local

# Demo-only: VITE_* values are visible in the browser bundle.
VITE_ENABLE_DEMO_ACCOUNTS=true
VITE_DEMO_PASSWORD=password123
VITE_DEMO_ADMIN_PASSWORD=admin123
