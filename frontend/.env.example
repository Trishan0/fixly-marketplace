# Local Vite uses /api through its dev proxy. On Vercel, set the full backend URL,
# for example: https://fixly-api.vercel.app/api
VITE_API_URL=/api

# Use "local" for normal local development and "blob" in Vercel Preview/Production.
VITE_STORAGE_DRIVER=local

# Demo sign-in shortcuts. Local `npm run dev` shows them automatically with the
# seed passwords. For any deployed build, VITE_* values are visible to everyone
# in the browser bundle: leave these unset in production. Only set all three
# for a throwaway demo environment whose accounts hold no real data.
# VITE_ENABLE_DEMO_ACCOUNTS=true
# VITE_DEMO_PASSWORD=
# VITE_DEMO_ADMIN_PASSWORD=

# Error reporting and product analytics (optional). Each SDK is only loaded
# when its key is set; only user id and role are sent, never names or emails.
# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
