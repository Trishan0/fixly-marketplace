DATABASE_URL=postgresql://username:password@localhost:5432/fixly
# Neon production: use the pooled (-pooler) URL above and the direct URL below.
MIGRATION_DATABASE_URL=postgresql://username:password@localhost:5432/fixly
DATABASE_POOL_MAX=3
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000
JWT_SECRET=fixly_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# AI agent layer (backend/src/agents). Without a valid key, the Job Match Agent
# and Proposal Agent silently fall back to deterministic rule-based scoring.
GEMINI_API_KEY=

# SMTP (use Mailtrap for dev: https://mailtrap.io)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
EMAIL_FROM=noreply@fixly.lk
# Recipient for messages submitted through the public contact form.
CONTACT_RECIPIENT_EMAIL=your-email@example.com

PORT=4000
CLIENT_URL=http://localhost:5173
# Optional comma-separated additional origins, useful for named preview URLs.
CLIENT_URLS=
NODE_ENV=development
MAX_FILE_SIZE=5242880

# Persistent uploads (Vercel Blob in production; local disk fallback in development).
# New Vercel connections use OIDC and store IDs. Static tokens remain supported
# for local development or legacy Blob connections.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
PUBLIC_BLOB_STORE_ID=
PRIVATE_BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
BLOB_READ_WRITE_TOKEN=
PRIVATE_BLOB_READ_WRITE_TOKEN=

# Required before intentionally seeding a production database.
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=password123
DEMO_ADMIN_PASSWORD=change-this-before-production
